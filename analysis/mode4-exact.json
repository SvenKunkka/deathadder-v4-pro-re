      ],
      "frame_hex": "025500",
      "fact": "Special reportinterval=1 slot0/3 branch writes DMA length2, data55 00 and bypasses common append. It fails normal receiver additive check. Do not silently normalize it or claim its purpose is proven."
    },
    {
      "id": "receiver-duplicate",
      "confidence": "high",
      "evidence": [
        "dongle 23024190 C lines80..112"
