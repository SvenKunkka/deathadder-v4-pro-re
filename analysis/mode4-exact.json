    {
      "id": "motion-aggregation",
      "confidence": "high for operations; medium for field names",
      "evidence": [
        "mouse 23025020..2302513E in 2302243C C"
      ],
      "layout": {
        "offset3": "buttons OR with latch and retained accumulator",
        "offset4": "wheel add modulo256",
        "offset5_6": "X add modulo65536, BE bytes",
        "offset7_8": "Y add modulo65536, BE bytes"
      },
      "fact": "Queue1 / reportinterval<3 branch pops input queue into retained accumulator, rebuilds cached packet on retry, and clears accumulation on CRCOK downlink. Other queue paths use deferred pop. Byte3 is NOT universally an opcode."
    },
    {
      "id": "short-frame-exception",
      "confidence": "high for bytes and bypass; purpose unresolved",
      "evidence": [
